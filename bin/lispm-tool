#!/bin/sh
# Copyright (C) 2026  Ryan.K
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# lispm-tool: call the tools LispM serves an agent, from the agent's shell.
#
#   lispm-tool               who you are among the agents, and the tools
#   lispm-tool NAME [INPUT]  call the tool NAME; INPUT is a JSON object,
#                            or - to read it from standard input
#
# An agent with a shell but no MCP client, as Holon, runs it.  It finds
# the agent's server in the directory $LISPM_PEERS, ~/.lispm/peers by
# default: LispM (lispm-agents-mcp.el) writes there, to a file named
# VARIABLE=VALUE, the address and token of the server of the agent whose
# commands have VARIABLE set to VALUE.  $LISPM_TOOL_SERVER names such a
# file directly.  An agent LispM did not start has no such file: it
# reaches the server LispM runs for agents outside it
# (lispm-mcp-server.el), which the file $LISPM_MCP_SERVER,
# ~/.lispm/mcp-server by default, names.  The result is printed; the
# exit status is 1 when the tool failed, 2 when no server answered.

set -u
peers=${LISPM_PEERS:-$HOME/.lispm/peers}
servers=${LISPM_MCP_SERVERS:-$HOME/.lispm/mcp-servers}
outside=${LISPM_MCP_SERVER:-$HOME/.lispm/mcp-server}
nl='
'

usage() {
  sed -n '7,9p' "$0" | sed 's/^# *//'
}

# The file naming this agent's server.
server_file() {
  if [ -n "${LISPM_TOOL_SERVER:-}" ]; then
    printf '%s\n' "$LISPM_TOOL_SERVER"
    return 0
  fi
  for file in "$peers"/*=*; do
    [ -f "$file" ] || continue
    name=${file##*/}
    variable=${name%%=*}
    value=${name#*=}
    case $variable in
      '' | [0-9]* | *[!A-Za-z0-9_]*) continue ;;
    esac
    eval "current=\${$variable-}"
    if [ -n "$current" ] && [ "$current" = "$value" ]; then
      printf '%s\n' "$file"
      return 0
    fi
  done
  if [ -n "${LISPM_MCP_SERVER:-}" ]; then
    if [ -f "$LISPM_MCP_SERVER" ]; then
      printf '%s\n' "$LISPM_MCP_SERVER"
      return 0
    fi
    return 1
  fi
  phys=$(pwd -P 2>/dev/null || pwd)
  best_file=
  best_len=0
  first_file=
  for candidate in "$servers"/*.server; do
    [ -f "$candidate" ] || continue
    u=
    t=
    p=
    r=
    {
      IFS= read -r u &&
      IFS= read -r t &&
      IFS= read -r p &&
      IFS= read -r r || [ -n "$p" ]
    } < "$candidate" 2>/dev/null || continue
    [ -n "$u" ] && [ -n "$t" ] || continue
    if [ -n "$p" ]; then
      case $p in
        *[!0-9]*) continue ;;
      esac
      kill -0 "$p" 2>/dev/null || continue
    fi
    base=${candidate##*/}
    if [ -n "${LISPM_MCP_INSTANCE:-}" ]; then
      case $base in
        "${LISPM_MCP_INSTANCE}" | "${LISPM_MCP_INSTANCE}"-* | "${LISPM_MCP_INSTANCE}".server)
          printf '%s\n' "$candidate"
          return 0
          ;;
      esac
      [ "$p" = "$LISPM_MCP_INSTANCE" ] && {
        printf '%s\n' "$candidate"
        return 0
      }
      continue
    fi
    [ -n "$first_file" ] || first_file=$candidate
    if [ -n "$r" ]; then
      r_phys=$(cd -P -- "$r" 2>/dev/null && pwd -P || printf '%s' "$r")
      r_clean=${r_phys%/}
      [ -n "$r_clean" ] || r_clean=/
      matched=0
      if [ "$r_clean" = "/" ]; then
        matched=1
      elif [ "$phys" = "$r_clean" ]; then
        matched=1
      else
        case "$phys/" in
          "$r_clean/"*) matched=1 ;;
        esac
      fi
      if [ "$matched" = 1 ] && [ "${#r_clean}" -gt "$best_len" ]; then
        best_file=$candidate
        best_len=${#r_clean}
      fi
    fi
  done
  if [ -n "$best_file" ]; then
    printf '%s\n' "$best_file"
    return 0
  elif [ -n "$first_file" ]; then
    printf '%s\n' "$first_file"
    return 0
  fi
  if [ -f "$outside" ]; then
    printf '%s\n' "$outside"
    return 0
  fi
  return 1
}

case ${1-} in
  -h | --help) usage; exit 0 ;;
esac

file=$(server_file) || {
  echo "lispm-tool: LispM serves this agent nothing: LispM has stopped" >&2
  exit 2
}
{ read -r url && read -r token; } < "$file" || {
  echo "lispm-tool: cannot read $file" >&2
  exit 2
}
cr=$(printf '\r')
case $token in
  *"$nl"* | *"$cr"*) echo "lispm-tool: invalid token in $file" >&2; exit 2 ;;
esac
case $PWD in
  *"$nl"* | *"$cr"*) echo "lispm-tool: working directory contains newline" >&2; exit 2 ;;
esac

# The token goes in a header read from a file descriptor, not in argv.
# The server for agents outside LispM takes the directory they work in.
if [ $# -eq 0 ]; then
  curl -sS --noproxy '*' -H @/dev/fd/3 "$url/tools" 3<<EOF || exit 2
Authorization: Bearer $token
X-LispM-Directory: $PWD
EOF
  exit 0
fi

name=$1
case $name in
  '' | *[!A-Za-z0-9_.-]*) echo "lispm-tool: not the name of a tool: $name" >&2; exit 2 ;;
esac
if [ $# -lt 2 ]; then
  input='{}'
elif [ "$2" = - ]; then
  input=$(cat)
else
  input=$2
fi

response=$(printf '%s' "$input" |
  curl -sS --noproxy '*' -H @/dev/fd/3 -H 'Content-Type: application/json' \
       --data-binary @- -w '\n%{http_code}' "$url/call/$name" 3<<EOF
Authorization: Bearer $token
X-LispM-Directory: $PWD
EOF
) || exit 2
status=${response##*"$nl"}
body=${response%"$nl"*}
printf '%s\n' "${body%"$nl"}"
[ "$status" = 200 ] || exit 1
