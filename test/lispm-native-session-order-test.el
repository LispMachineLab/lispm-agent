;;; lispm-native-session-order-test.el --- Standalone session lifecycle -*- lexical-binding: t; -*-

(require 'ert)
(require 'lispm-runtime)

(defun lispm-test--native-opened (agent)
  "Return the recorded opening time of native AGENT."
  (lispm-agents-session-opened-time (list :agent 'lispm :id (lispm-agent-id agent))))

(ert-deftest lispm-test-native-opening-and-resume-without-desktop ()
  "Native creation, ordering and resume work without host UI hooks."
  (lispm-test-env
    (let ((now 100.0) (clock (symbol-function 'float-time)))
      (cl-letf (((symbol-function 'float-time)
                 (lambda (&optional time) (if time (funcall clock time) now))))
        (let* ((older (lispm-start 'assistant project))
               (file (buffer-file-name (lispm-agent-buffer older))))
          (lispm--in-session older (insert "First request"))
          (lispm--save-session older)
          (should (= (lispm-test--native-opened older) 100))
          (setq now 200.0)
          (let ((newer (lispm-start 'assistant project)))
            (lispm--in-session newer (insert "Second request"))
            (lispm--save-session newer)
            (should (equal (mapcar (lambda (session) (plist-get session :id)) (lispm-sessions))
                           (list (lispm-agent-id newer) (lispm-agent-id older))))
            ;; A response updates the transcript, not its opening order.
            (lispm--in-session older (insert "Recent response"))
            (lispm--save-session older)
            (set-file-times file (seconds-to-time 2000000000))
            (should (equal (plist-get (car (lispm-sessions)) :id) (lispm-agent-id newer)))
            (lispm-retire older)
            ;; A metadata edit must not count as resuming the transcript.
            (setq now 300.0)
            (lispm-rename-session file "Renamed conversation")
            (setq lispm-agents--opened-times nil)
            (should (= (lispm-test--native-opened older) 100))
            (setq now 400.0)
            (let ((resumed (lispm-resume-file file)))
              (should (= (lispm-test--native-opened resumed) 400))
              (should (equal (plist-get (car (lispm-sessions)) :id) (lispm-agent-id older)))
              (setq now 500.0)
              (should (eq resumed (lispm-resume-file file)))
              (lispm-session-buffer resumed)
              (with-current-buffer (lispm-agent-buffer resumed) (lispm-session-mode 1))
              (should (= (lispm-test--native-opened resumed) 400)))))))))

(ert-deftest lispm-test-native-views-and-continuations-do-not-reopen ()
  "Chat creation, status changes and compaction preserve opening time."
  (lispm-test-env
    (let ((now 100.0) (clock (symbol-function 'float-time))
          (writer (symbol-function 'lispm-agents-session-opened)) (writes 0))
      (cl-letf (((symbol-function 'float-time)
                 (lambda (&optional time) (if time (funcall clock time) now)))
                ((symbol-function 'lispm-agents-session-opened)
                 (lambda (&rest args) (cl-incf writes) (apply writer args))))
        (let* ((agent (lispm-start 'assistant project))
               (file (buffer-file-name (lispm-agent-buffer agent))))
          (should (= writes 1))
          (setq now 200.0)
          (lispm-chat agent)
          (lispm-set-state agent 'idle)
          (should (= writes 1))
          (setq now 300.0)
          (setf (lispm-agent-compacting agent) t)
          (lispm--continue agent "Continue the same conversation.")
          (should-not (equal file (buffer-file-name (lispm-agent-buffer agent))))
          (should (= (lispm-test--native-opened agent) 100))
          (should (= writes 1)))))))

(ert-deftest lispm-test-native-standing-clear-and-direct-adoption ()
  "Standing reuse, clear and direct transcript opens have real lifecycle times."
  (lispm-test-env
    (let ((now 100.0) (clock (symbol-function 'float-time))
          (agent (lispm-defagent persistent :root project)))
      (cl-letf (((symbol-function 'float-time)
                 (lambda (&optional time) (if time (funcall clock time) now))))
        (lispm-session-buffer agent)
        (let ((first-id (lispm-agent-id agent)))
          (setq now 200.0)
          (lispm-session-buffer agent)
          (should (= (lispm-test--native-opened agent) 100))
          (setq now 300.0)
          (lispm-session-buffer agent t)
          (should-not (equal first-id (lispm-agent-id agent)))
          (should (= (lispm-test--native-opened agent) 300))
          (should (= (lispm-agents-session-opened-time (list :agent 'lispm :id first-id)) 100)))
        (let ((file (buffer-file-name (lispm-agent-buffer agent))))
          (lispm-retire agent)
          (setq now 400.0)
          (find-file-noselect file)
          (should (= (lispm-test--native-opened agent) 400))
          (should (buffer-live-p (lispm-agent-buffer agent))))))))

(provide 'lispm-native-session-order-test)
;;; lispm-native-session-order-test.el ends here
