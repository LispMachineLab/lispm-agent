;;; lispm-agents-archive-tree-test.el --- Archive inheritance -*- lexical-binding: t; -*-

(require 'ert)
(require 'lispm-agents)

(defun lispm-test--archive-session (agent id &optional parent cwd)
  "Make an archive fixture for AGENT's ID, optionally under PARENT in CWD."
  (list :agent agent :id id :parent parent :cwd (or cwd "/tmp/project/")
        :title id :started 1 :time 1))

(ert-deftest lispm-test-archive-tree-inherits-old-state-with-absent-parent ()
  "A persisted parent choice applies even when only its descendants are read."
  (let* ((child (lispm-test--archive-session 'codex "child" "root" "/tmp/worktree/"))
         (grandchild (lispm-test--archive-session 'codex "grandchild" "child" "/tmp/elsewhere/"))
         (other (lispm-test--archive-session 'claude "child" "root"))
         (rows (list child grandchild))
         (lispm-agents--session-parents nil)
         (lispm-agents--effective-archive nil))
    (lispm-test--with-agents
        `((codex :name "Codex" :new ignore :sessions ,(lambda () rows))
          (claude :name "Claude" :new ignore :sessions ,(lambda () (list other))))
      (with-temp-file lispm-agents-state-file
        (prin1 '(:archived ("codex:root") :opened (("codex:root" . 42))) (current-buffer)))
      (let ((before (with-temp-buffer (insert-file-contents lispm-agents-state-file) (buffer-string))))
        (lispm-agents-sessions-list)
        (should (lispm-agents-archived-p child))
        (should (lispm-agents-archived-p grandchild))
        (should-not (lispm-agents-archived-p other))
        (should (equal before (with-temp-buffer (insert-file-contents lispm-agents-state-file) (buffer-string))))
        (should (equal (lispm-agents--archived-keys) '("codex:root")))))))

(ert-deftest lispm-test-archive-tree-late-children-and-restart ()
  "A snapshot indexes new descendants before filtering, including after restart."
  (let* ((root (lispm-test--archive-session 'claude "root"))
         (child (lispm-test--archive-session 'claude "child" "root"))
         (grandchild (lispm-test--archive-session 'claude "grandchild" "child"))
         (rows (list root))
         (lispm-agents--session-readers nil)
         (lispm-agents--session-parents nil)
         (lispm-agents--effective-archive nil))
    (lispm-test--with-agents
        `((claude :name "Claude" :new ignore :sessions ,(lambda () rows)))
      (lispm-agents--set-archived root t)
      (lispm-agents-add-session-reader 'claude (lambda () rows))
      (lispm-agents-sessions-snapshot)
      (setq rows (list root child grandchild))
      (lispm-agents-sessions-snapshot)
      (should (lispm-agents-archived-p grandchild))
      (setq lispm-agents--archived 'unloaded
            lispm-agents--session-parents nil
            lispm-agents--effective-archive nil)
      (lispm-agents-sessions-snapshot)
      (should (lispm-agents-archived-p grandchild))
      (should (equal (plist-get (lispm-agents--read-state) :archived) '("claude:root"))))))

(ert-deftest lispm-test-archive-tree-restores-inherited-children-only ()
  "One write archives a branch; restoring it preserves a child's own choice."
  (let* ((root (lispm-test--archive-session 'codex "root"))
         (child (lispm-test--archive-session 'codex "child" "root"))
         (grandchild (lispm-test--archive-session 'codex "grandchild" "child"))
         (sibling (lispm-test--archive-session 'codex "sibling" "root"))
         (rows (list root child grandchild sibling))
         (lispm-agents--session-parents nil)
         (lispm-agents--effective-archive nil)
         (lispm-agents-sessions-changed-hook nil)
         (writer (symbol-function 'lispm-agents--write-state))
         (writes 0))
    (lispm-test--with-agents
        `((codex :name "Codex" :new ignore :sessions ,(lambda () rows)))
      (lispm-agents-sessions-list)
      (lispm-agents-session-opened 'codex "root" 42)
      (lispm-agents--set-archived child t)
      (cl-letf (((symbol-function 'lispm-agents--write-state)
                 (lambda (state) (cl-incf writes) (funcall writer state))))
        (lispm-agents-toggle-archive-session root)
        (should (= writes 1))
        (should (lispm-agents-archived-p sibling))
        ;; Drawing any number of rows neither rescans nor reads/writes state.
        (cl-letf (((symbol-function 'lispm-agents--read-state) (lambda () (error "Read during filtering")))
                  ((symbol-function 'lispm-agents-sessions-list) (lambda (&rest _) (error "Scan during filtering"))))
          (dotimes (_ 100) (should (lispm-agents-archived-p grandchild))))
        (should-error (lispm-agents-toggle-archive-session sibling) :type 'user-error)
        (should-error (lispm-agents-toggle-archive-session child) :type 'user-error)
        (should (= writes 1))
        (lispm-agents-toggle-archive-session root)
        (should (= writes 2)))
      (should-not (lispm-agents-archived-p root))
      (should-not (lispm-agents-archived-p sibling))
      (should (lispm-agents-archived-p child))
      (should (lispm-agents-archived-p grandchild))
      (should (equal (plist-get (lispm-agents--read-state) :opened) '(("codex:root" . 42)))))))

(ert-deftest lispm-test-archive-tree-user-input-restores-path-once ()
  "Writing to a child reveals its path without restoring independent siblings."
  (let* ((root (lispm-test--archive-session 'codex "root"))
         (child (lispm-test--archive-session 'codex "child" "root"))
         (grandchild (lispm-test--archive-session 'codex "grandchild" "child"))
         (sibling (lispm-test--archive-session 'codex "sibling" "root"))
         (rows (list root child grandchild sibling))
         (lispm-agents--session-parents nil)
         (lispm-agents--effective-archive nil)
         (changed 0) (writes 0)
         (writer (symbol-function 'lispm-agents--write-state))
         (lispm-agents-sessions-changed-hook (list (lambda () (cl-incf changed)))))
    (lispm-test--with-agents
        `((codex :name "Codex" :new ignore :sessions ,(lambda () rows)))
      (lispm-agents-sessions-list)
      (dolist (session (list root child grandchild sibling))
        (lispm-agents--set-archived session t))
      ;; Clearing a deleted child's explicit key must not restore its ancestors.
      (lispm-agents--set-archived grandchild nil)
      (should (lispm-agents-archived-p grandchild))
      (cl-letf (((symbol-function 'lispm-agents--write-state)
                 (lambda (state) (cl-incf writes) (funcall writer state))))
        (should (lispm-agents-user-wrote 'codex "grandchild"))
        (should (= writes 1))
        (should (= changed 1))
        (should-not (lispm-agents-user-wrote 'codex "grandchild"))
        (should (= writes 1))
        (should (= changed 1)))
      (should-not (lispm-agents-archived-p grandchild))
      (should-not (lispm-agents-archived-p child))
      (should-not (lispm-agents-archived-p root))
      (should (lispm-agents-archived-p sibling))
      (should (equal (lispm-agents--archived-keys) '("codex:sibling"))))))

(ert-deftest lispm-test-archive-tree-cycles-and-changed-parent ()
  "Malformed cycles terminate and new snapshots discard stale parent links."
  (let* ((a (lispm-test--archive-session 'codex "a" "b"))
         (b (lispm-test--archive-session 'codex "b" "a"))
         (rows (list a b))
         (lispm-agents--session-parents nil)
         (lispm-agents--effective-archive nil)
         (lispm-agents-sessions-changed-hook nil))
    (lispm-test--with-agents
        `((codex :name "Codex" :new ignore :sessions ,(lambda () rows)))
      (lispm-agents-sessions-list)
      (should-not (lispm-agents-archived-p a))
      (lispm-agents--set-archived a t)
      (should (lispm-agents-archived-p b))
      (should (lispm-agents-user-wrote 'codex "b"))
      (should-not (lispm-agents-archived-p a))
      (lispm-agents--set-archived a t)
      (setq b (lispm-test--archive-session 'codex "b"))
      (setq rows (list a b))
      (lispm-agents-sessions-list)
      (should-not (lispm-agents-archived-p b)))))

(ert-deftest lispm-test-archive-tree-partial-graph-context ()
  "Partial callers can inherit known ancestors without replacing their graph."
  (let* ((root (lispm-test--archive-session 'codex "root"))
         (child (lispm-test--archive-session 'codex "child" "root"))
         (grandchild (lispm-test--archive-session 'codex "grandchild" "child"))
         (lispm-agents--session-parents nil)
         (lispm-agents--effective-archive nil))
    (lispm-test--with-agents nil
      (lispm-agents--index-session-parents (list root child))
      (lispm-agents--set-archived root t)
      (let ((lispm-agents--session-parents lispm-agents--session-parents)
            (lispm-agents--effective-archive nil))
        (lispm-agents--index-session-parents (list grandchild) t)
        (should (lispm-agents-archived-p grandchild))
        (lispm-agents--index-session-parents (list (lispm-test--archive-session 'codex "child")) t)
        (should-not (lispm-agents-archived-p grandchild)))
      (should (= (hash-table-count (cdr lispm-agents--session-parents)) 1))
      (should (lispm-agents-archived-p child)))))

(provide 'lispm-agents-archive-tree-test)
;;; lispm-agents-archive-tree-test.el ends here
