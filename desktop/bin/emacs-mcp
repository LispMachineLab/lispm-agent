#!/usr/bin/env python3
"""Hermes's stdio MCP server for Emacs: a bridge to the terminal's HTTP server.

Hermes reads its MCP servers from its config file alone and starts a stdio
server as a subprocess.  Emacs serves each Hermes terminal over HTTP on a
port of its own (see lispm-desktop-agent-mcp.el), so this bridge carries each JSON-RPC
line from stdin to that server and writes the response to stdout:

  stdin line --POST LISPM_DESKTOP_EMACS_MCP_URL, bearer token from
             LISPM_DESKTOP_EMACS_MCP_TOKEN_FILE--> response line on stdout

Outside an Emacs terminal neither variable is set (Hermes leaves its ${...}
placeholders in place), and the bridge is a server with no tools, so Hermes
runs as usual and reports nothing failed.
"""
import json
import os
import sys
import urllib.error
import urllib.request


def setting(name):
    """Return the environment variable NAME, or None when unset or a placeholder."""
    value = os.environ.get(name, "")
    return None if not value or "${" in value else value


URL = setting("LISPM_DESKTOP_EMACS_MCP_URL")
TOKEN_FILE = setting("LISPM_DESKTOP_EMACS_MCP_TOKEN_FILE")
# Emacs listens on loopback; a system proxy must not see these requests.
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def read_token():
    """Return the token Emacs wrote for this terminal, or None."""
    try:
        with open(TOKEN_FILE, encoding="utf-8") as handle:
            return handle.read().strip() or None
    except OSError:
        return None


TOKEN = read_token() if URL and TOKEN_FILE else None


def write(payload):
    """Write PAYLOAD, bytes of one JSON message, as one stdout line."""
    sys.stdout.buffer.write(payload + b"\n")
    sys.stdout.buffer.flush()


def reply(message):
    write(json.dumps(message, ensure_ascii=False).encode("utf-8"))


def result(request_id, value):
    return {"jsonrpc": "2.0", "id": request_id, "result": value}


def error(request_id, code, text):
    return {"jsonrpc": "2.0", "id": request_id, "error": {"code": code, "message": text}}


def answer_alone(message):
    """Answer MESSAGE as a server with no tools: the bridge outside Emacs."""
    request_id = message.get("id")
    if request_id is None:
        return
    method = message.get("method")
    if method == "initialize":
        version = (message.get("params") or {}).get("protocolVersion") or "2025-06-18"
        reply(result(request_id, {"protocolVersion": version,
                                  "capabilities": {"tools": {}},
                                  "serverInfo": {"name": "Emacs", "version": "0"}}))
    elif method == "tools/list":
        reply(result(request_id, {"tools": []}))
    elif method == "ping":
        reply(result(request_id, {}))
    else:
        reply(error(request_id, -32601, f"Method not found: {method}"))


def forward(line, message):
    """Send LINE, the JSON-RPC MESSAGE, to Emacs and relay its answer."""
    request = urllib.request.Request(
        URL, data=line.encode("utf-8"), method="POST",
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {TOKEN}"})
    try:
        with OPENER.open(request, timeout=120) as response:
            body = response.read()
            if response.status == 200 and body:
                write(body)
    except (urllib.error.URLError, OSError) as exc:
        if message.get("id") is not None:
            reply(error(message["id"], -32000, f"Emacs did not answer: {exc}"))


def main():
    for raw in sys.stdin.buffer:
        line = raw.decode("utf-8", "replace").strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if not isinstance(message, dict):
            continue
        if TOKEN:
            forward(line, message)
        else:
            answer_alone(message)


if __name__ == "__main__":
    main()
